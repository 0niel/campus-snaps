

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//////////////////////////////

//////////////////////////////

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? 
  access_token             String? 
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? 
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([identifier, token])
  @@index([identifier])
  @@map("verification_tokens")
}

//////////////////////////////

//////////////////////////////

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  password          String? 
  role              String   @default("STUDENT") 
  academicGroupId   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  
  accounts          Account[]
  sessions          Session[]

  
  photos            Photo[]
  comments          Comment[]
  likes             Like[]
  following         Follow[] @relation("Following")
  followers         Follow[] @relation("Followers")
  albums            Album[]  @relation("OwnerAlbums")
  academicGroup     AcademicGroup?   @relation(fields: [academicGroupId], references: [id])
  
  albumAllowedUsers AlbumAllowedUser[]
}

model Follow {
  followerId String
  followingId String
  follower    User @relation("Following", fields: [followerId], references: [id])
  following   User @relation("Followers", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  date        DateTime
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos      Photo[]
  albums      AlbumEvent[]
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  photos    PhotoTag[]
}

model Photo {
  id          Int      @id @default(autoincrement())
  userId      String
  eventId     Int?
  url         String
  description String?
  uploadDate  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  event       Event?   @relation(fields: [eventId], references: [id])
  tags        PhotoTag[]
  comments    Comment[]
  likes       Like[]
  albums      AlbumPhoto[]
}

model PhotoTag {
  photoId   Int
  tagId     Int
  photo     Photo    @relation(fields: [photoId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
  
  @@id([photoId, tagId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  photoId   Int
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photo     Photo    @relation(fields: [photoId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Like {
  userId    String
  photoId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  photo     Photo    @relation(fields: [photoId], references: [id])
  
  @@id([userId, photoId])
}

model AcademicGroup {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  albums      Album[]  @relation("GroupAlbums")
}

//////////////////////////////

//////////////////////////////

model Album {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  coverImage      String?
  ownerId         String?
  academicGroupId Int?
  
  privacy         String   @default("public")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User?     @relation("OwnerAlbums", fields: [ownerId], references: [id])
  academicGroup   AcademicGroup? @relation("GroupAlbums", fields: [academicGroupId], references: [id])
  photos          AlbumPhoto[]
  events          AlbumEvent[]
  allowedUsers    AlbumAllowedUser[]
}

model AlbumPhoto {
  albumId   Int
  photoId   Int
  createdAt DateTime @default(now())

  album     Album   @relation(fields: [albumId], references: [id])
  photo     Photo   @relation(fields: [photoId], references: [id])
  
  @@id([albumId, photoId])
}

model AlbumEvent {
  albumId   Int
  eventId   Int
  createdAt DateTime @default(now())

  album     Album   @relation(fields: [albumId], references: [id])
  event     Event   @relation(fields: [eventId], references: [id])
  
  @@id([albumId, eventId])
}


model AlbumAllowedUser {
  albumId   Int
  userId    String
  createdAt DateTime @default(now())

  album     Album @relation(fields: [albumId], references: [id])
  user      User  @relation(fields: [userId], references: [id])
  
  @@id([albumId, userId])
}
